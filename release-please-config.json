{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "last-release-sha": "5001b8ccd91a3a9f9ef47f5fc6efe50f0a86f715",
  "include-v-in-tag": true,
  "initial-version": "0.1.0",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "build",
      "section": "Build & Dependencies"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Chores",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "component": "server",
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "exclude-paths": ["pmon", "mysqlwire"],
      "extra-files": [
        {
          "type": "json",
          "path": "web/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "control-plane/src/main/resources/proxymonster/server-version.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "pmon": {
      "component": "pmon",
      "release-type": "go",
      "version-file": "version.go",
      "changelog-path": "CHANGELOG.md"
    },
    "mysqlwire": {
      "component": "mysqlwire",
      "release-type": "go",
      "tag-separator": "/",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
